{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codecorvus.com/schemas/evidence-export.v1.json",
  "title": "CodeCorvus evidence export v1",
  "description": "Signed evidence export (metadata only). HOW TO VERIFY (what `corvus-verify` does, offline): (1) SIGNATURE: Ed25519 with the public key served at /.well-known/codecorvus-evidence.pub (key_id = 'ed25519-' + first 16 hex chars of sha256 of the public key), over the CANONICAL FORM of `content`: JSON with no whitespace outside strings; object keys in ascending UTF-8 byte order, no duplicates; integers only, in minimal decimal form; valid UTF-8 strings escaping only the quote, the backslash and U+0000–U+001F (\\b \\t \\n \\f \\r; others as lowercase \\u00xx), everything else literal. (2) RECORD HASH: hex(sha256(previous_hash + '\\n' + J)), where J is a JSON object with exactly these keys, in this order, each holding the value of the record field in parentheses: tenant_id (from tenant_id), posicao (from position), id (from id), tipo (from type), revisao_id (from review_id), achado_id (from finding_id), ator_usuario_id (from actor_user_id), ator_login (from actor_login), dados (from data), em (from at); no whitespace, keys of `data` sorted, and Go encoding/json escaping (<, > and & as \\u003c, \\u003e, \\u0026; U+2028 and U+2029 as \\u2028 and \\u2029). These hash keys are fixed by the format and differ from the export field names on purpose: they are the keys under which the audit trail hashes each record when it is written, so every record, including those written before this format, stays verifiable. (3) CHAINING: the first record has previous_hash = trail.previous_hash (64 zeros when from_position = 1); each record points to the previous hash; positions are contiguous from from_position to to_position; total = number of records; last_hash = hash of the last one. (4) TOTALS: coverage.exceptions and coverage.unjustified match the list of exceptions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "content",
    "signature"
  ],
  "properties": {
    "format": {
      "const": "codecorvus.evidence-export.v1"
    },
    "content": {
      "$ref": "#/$defs/content"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "public_key",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "key_id": {
          "type": "string",
          "pattern": "^ed25519-[0-9a-f]{16}$"
        },
        "public_key": {
          "type": "string",
          "description": "32 bytes, base64; compare with the published key (--key)"
        },
        "value": {
          "type": "string",
          "description": "64 bytes, base64: Ed25519 over the canonical form of content"
        }
      }
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "org",
        "generated_at",
        "generated_by",
        "confirmed_with",
        "period",
        "filters",
        "data_since",
        "coverage",
        "exceptions",
        "trail"
      ],
      "properties": {
        "format": {
          "const": "codecorvus.evidence-export.v1"
        },
        "org": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "login",
            "tenant_id"
          ],
          "properties": {
            "login": {
              "type": "string"
            },
            "tenant_id": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "generated_by": {
          "type": "string",
          "description": "Login of the person who exported"
        },
        "confirmed_with": {
          "enum": [
            "passkey",
            "app_autenticador",
            "codigo_recuperacao"
          ]
        },
        "period": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "from": {
              "type": "string",
              "format": "date"
            },
            "to": {
              "type": "string",
              "format": "date",
              "description": "Inclusive (UTC)"
            }
          }
        },
        "filters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repos",
            "branches"
          ],
          "properties": {
            "repos": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "description": "Empty = all"
            },
            "branches": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Empty = the branches protected by the gate"
            }
          }
        },
        "data_since": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "merged_prs",
            "reviewed_before_merge",
            "reviewed_permille",
            "exceptions",
            "unjustified",
            "p90_time_to_review_s"
          ],
          "properties": {
            "merged_prs": {
              "type": "integer",
              "minimum": 0
            },
            "reviewed_before_merge": {
              "type": "integer",
              "minimum": 0
            },
            "reviewed_permille": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 1000
            },
            "exceptions": {
              "type": "integer",
              "minimum": 0
            },
            "unjustified": {
              "type": "integer",
              "minimum": 0
            },
            "p90_time_to_review_s": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "exceptions": {
          "type": "array",
          "description": "Every exception in the period and filters",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "merge_id",
              "type",
              "reason",
              "repo",
              "pr",
              "pr_url",
              "base",
              "head_sha",
              "merge_sha",
              "merged_at",
              "merged_by",
              "review_id",
              "justified",
              "justification"
            ],
            "properties": {
              "merge_id": {
                "type": "string",
                "format": "uuid"
              },
              "type": {
                "enum": [
                  "merge_com_bloqueante_aberto",
                  "merge_admin_por_cima",
                  "merge_sem_revisao",
                  "autoliberacao",
                  "revisao_parcial"
                ]
              },
              "reason": {
                "type": "string"
              },
              "repo": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "name"
                ],
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "name": {
                    "type": "string"
                  }
                }
              },
              "pr": {
                "type": "integer",
                "minimum": 1
              },
              "pr_url": {
                "type": "string",
                "format": "uri"
              },
              "base": {
                "type": "string"
              },
              "head_sha": {
                "$ref": "#/$defs/sha"
              },
              "merge_sha": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/sha"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "merged_at": {
                "type": "string",
                "format": "date-time"
              },
              "merged_by": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "review_id": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uuid"
              },
              "justified": {
                "type": "boolean"
              },
              "justification": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "reason",
                      "link",
                      "by",
                      "at"
                    ],
                    "properties": {
                      "reason": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "maxLength": 500
                      },
                      "link": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "by": {
                        "type": "string"
                      },
                      "at": {
                        "type": "string",
                        "format": "date-time"
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "trail": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from_position",
            "to_position",
            "total",
            "previous_hash",
            "last_hash",
            "records"
          ],
          "description": "Contiguous slice of the tenant chain: from the first to the last record with `at` in the period, not filtered by repository. Empty: positions 0 and empty hashes.",
          "properties": {
            "from_position": {
              "type": "integer",
              "minimum": 0
            },
            "to_position": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "previous_hash": {
              "type": "string",
              "pattern": "^([0-9a-f]{64})?$"
            },
            "last_hash": {
              "type": "string",
              "pattern": "^([0-9a-f]{64})?$"
            },
            "records": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tenant_id",
                  "position",
                  "id",
                  "type",
                  "review_id",
                  "finding_id",
                  "actor_user_id",
                  "actor_login",
                  "data",
                  "at",
                  "previous_hash",
                  "hash"
                ],
                "properties": {
                  "tenant_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "position": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "type": {
                    "type": "string"
                  },
                  "review_id": {
                    "type": "string",
                    "description": "Empty when absent"
                  },
                  "finding_id": {
                    "type": "string"
                  },
                  "actor_user_id": {
                    "type": "string"
                  },
                  "actor_login": {
                    "type": "string",
                    "description": "Empty = the system (CodeCorvus)"
                  },
                  "data": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "at": {
                    "type": "string",
                    "description": "RFC 3339 in UTC, fraction without trailing zeros: the exact text that is hashed"
                  },
                  "previous_hash": {
                    "$ref": "#/$defs/hash"
                  },
                  "hash": {
                    "$ref": "#/$defs/hash"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
